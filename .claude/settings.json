{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(node --test tests/*)",
      "Bash(node scripts/qa/validate-plant-data.js)",
      "Bash(node scripts/qa/scan-secrets.js)",
      "Bash(node scripts/qa/check-syntax.js)",
      "mcp__github__get_me",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__list_branches",
      "mcp__github__list_commits",
      "mcp__github__get_commit",
      "mcp__github__get_file_contents",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__supabase__search_docs",
      "mcp__supabase__get_project",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_migrations",
      "mcp__supabase__list_extensions",
      "mcp__supabase__list_edge_functions",
      "mcp__supabase__get_advisors",
      "mcp__supabase__get_logs",
      "mcp__Supabase__search_docs",
      "mcp__Supabase__list_projects",
      "mcp__Supabase__get_project",
      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_migrations",
      "mcp__Supabase__list_extensions",
      "mcp__Supabase__list_edge_functions",
      "mcp__Supabase__get_advisors",
      "mcp__Supabase__query_logs",
      "mcp__Vercel__list_teams",
      "mcp__Vercel__list_projects",
      "mcp__Vercel__get_project",
      "mcp__Vercel__list_deployments",
      "mcp__Vercel__get_deployment",
      "mcp__Vercel__list_deployment_events",
      "mcp__Vercel__get_runtime_errors",
      "mcp__Vercel__get_runtime_logs"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash drop *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npm audit fix *)",
      "Bash(npx *)",
      "Bash(pip install *)",
      "Bash(curl *)",
      "Bash(psql *)",
      "Bash(supabase *)",
      "Bash(python scripts/*)",
      "Bash(python3 scripts/*)",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__add_issue_comment",
      "mcp__github__create_branch",
      "mcp__supabase__execute_sql",
      "mcp__Supabase__execute_sql",
      "mcp__github__actions_run_trigger",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.preview)",
      "Read(./.vercel/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*service-account*.json)",
      "Read(./**/*credentials*.json)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.production)",
      "Edit(./.env.development)",
      "Edit(./.env.preview)",
      "Edit(./.vercel/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *--force-with-lease*)",
      "Bash(git push * +*)",
      "Bash(git push * --delete *)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git update-ref -d *)",
      "Bash(rm -rf *)",
      "Bash(gh pr merge *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(supabase db push *)",
      "Bash(supabase db reset *)",
      "Bash(supabase migration up *)",
      "Bash(supabase functions deploy *)",
      "Bash(supabase secrets *)",
      "Bash(npx supabase *)",
      "Bash(node --env-file=.env *)",
      "Bash(node scripts/bulk-import-orphan-photos.js *)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__delete_file",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "mcp__supabase__apply_migration",
      "mcp__supabase__deploy_edge_function",
      "mcp__supabase__create_branch",
      "mcp__supabase__delete_branch",
      "mcp__supabase__merge_branch",
      "mcp__supabase__reset_branch",
      "mcp__supabase__rebase_branch",
      "mcp__supabase__create_project",
      "mcp__supabase__pause_project",
      "mcp__supabase__restore_project",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__deploy_edge_function",
      "mcp__Supabase__create_branch",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__rebase_branch",
      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "mcp__Vercel__create_deployment",
      "mcp__Vercel__cancel_deployment",
      "mcp__Vercel__request_promote",
      "mcp__Vercel__request_rollback",
      "mcp__Vercel__update_project",
      "mcp__Vercel__pause_project",
      "mcp__Vercel__unpause_project",
      "mcp__Vercel__create_project",
      "mcp__Vercel__create_project_env",
      "mcp__Vercel__edit_project_env",
      "mcp__Vercel__get_project_env",
      "mcp__Vercel__filter_project_envs",
      "mcp__Vercel__add_project_domain",
      "mcp__Vercel__assign_alias",
      "mcp__Vercel__get_auth_token",
      "mcp__Vercel__get_project_token"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-git.sh\""
          }
        ]
      }
    ]
  }
}
