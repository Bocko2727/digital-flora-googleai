PORT=3000
# Project API URL and publishable (or legacy anon) key; both are served to the
# browser by /api/config, so neither may be a server key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only key: the legacy service_role JWT or a new sb_secret_ key
# (SUPABASE_SECRET_KEY is accepted as well). Used for Storage uploads and for
# the Data API fallback; never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# On Vercel use the Transaction pooler URI from Supabase > Connect
# (postgres.<ref>@aws-*.pooler.supabase.com:6543). The direct host
# db.<ref>.supabase.co is IPv6-only and unreachable from Vercel. When the pool
# cannot connect, reads and writes fall back to the Data API.
SUPABASE_DB_URL=
# Optional (P1.3): PEM contents of the CA cert from Supabase Dashboard ->
# Database Settings -> SSL Configuration. When set, src/db/supabase.js uses
# sslmode=verify-full; when unset, falls back to the previous relaxed
# verification so this stays optional to adopt. sslmode parameters in
# SUPABASE_DB_URL are ignored; this setting alone controls TLS.
SUPABASE_DB_CA_CERT=
GEMINI_API_KEY=
KILO_API_KEY=
KILO_BASE_URL=https://api.kilo.ai/v1
KILO_MODEL=kilo-auto
