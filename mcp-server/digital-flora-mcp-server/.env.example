# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project URL, e.g. https://sxuxtsbyqjaodyuqebux.supabase.co
SUPABASE_URL=https://sxuxtsbyqjaodyuqebux.supabase.co

# Service role key (Project Settings -> API -> service_role, "secret").
# This bypasses Row Level Security, so keep it server-side only -
# never ship it to a browser or a public repo.
SUPABASE_SERVICE_ROLE_KEY=


# "stdio" (default) for local/Claude Desktop use, "http" to run as a
# remote server (e.g. deployed behind a small Node host).
TRANSPORT=stdio

# Only used when TRANSPORT=http
PORT=3000

# Required when TRANSPORT=http. Random shared secret so /mcp isn't reachable
# by anyone who guesses the URL (this server can bypass Supabase RLS).
# Generate with: openssl rand -hex 32
MCP_SERVER_TOKEN=
